{
  "name": "@jason12196/weshop-skill-package",
  "version": "0.2.0",
  "private": true,
  "description": "Content-first WeShop Router, Atom Skills, model catalog, and maintenance tooling.",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean --silent && tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js && npm run test:auto-update && npm run test:custom-skills",
    "test:auto-update": "node --test scripts/auto-update.test.mjs",
    "test:custom-skills": "node --test scripts/custom-skills.test.mjs",
    "models:validate": "node scripts/validate-model-catalog.mjs",
    "models:routing-validate": "node scripts/validate-model-routing.mjs",
    "api-key:check": "node scripts/check-api-key.mjs",
    "prepare": "npm run build",
    "skills:manage": "node scripts/manage-skills.mjs",
    "skills:auto-update": "node scripts/auto-update.mjs",
    "skills:intake": "node scripts/create-skill-intake.mjs",
    "skills:custom:init": "node scripts/create-custom-skill-draft.mjs",
    "skills:custom:review": "node skills/review-custom-skill/scripts/review-custom-skill.mjs",
    "docs:validate": "node scripts/validate-readme.mjs",
    "maintainers:validate": "node scripts/validate-maintainer-docs.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "devDependencies": { "@types/node": "^22.15.3", "typescript": "^5.8.3" }
}
