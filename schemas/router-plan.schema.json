{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weshop.ai/schemas/router-plan.schema.json",
  "title": "WeShop Router decision",
  "description": "A routing-only decision. The Agent Runtime and selected Skill or workflow own execution, receipts, recovery, and acceptance.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "taskClassId",
    "selectionSource",
    "candidateSkillIds",
    "candidateWorkflowIds",
    "requiredInputs",
    "missingInputs",
    "reason",
    "nextAction",
    "availableSkillCount"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "kind": {
      "enum": [
        "direct",
        "workflow",
        "clarify"
      ]
    },
    "taskClassId": {
      "$ref": "#/$defs/openId"
    },
    "taskId": {
      "$ref": "#/$defs/openId"
    },
    "selectionSource": {
      "enum": [
        "indexed",
        "runtime-fallback"
      ]
    },
    "recommendedSkillId": {
      "$ref": "#/$defs/openId"
    },
    "selectedSkillId": {
      "$ref": "#/$defs/openId"
    },
    "candidateSkillIds": {
      "$ref": "#/$defs/idSet"
    },
    "workflowId": {
      "$ref": "#/$defs/openId"
    },
    "candidateWorkflowIds": {
      "$ref": "#/$defs/idSet"
    },
    "requiredInputs": {
      "$ref": "#/$defs/stringSet"
    },
    "missingInputs": {
      "$ref": "#/$defs/stringSet"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "nextAction": {
      "enum": [
        "score-skill-candidates",
        "invoke-selected-skill",
        "select-workflow",
        "invoke-selected-workflow",
        "ask-one-question"
      ]
    },
    "availableSkillCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "clarify"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "question"
        ],
        "properties": {
          "nextAction": {
            "const": "ask-one-question"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "selectedSkillId"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "direct"
          },
          "nextAction": {
            "const": "invoke-selected-skill"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "workflowId"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "workflow"
          },
          "nextAction": {
            "const": "invoke-selected-workflow"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "openId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/openId"
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
