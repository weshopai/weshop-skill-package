{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source", "lastVerifiedAt", "models"],
  "properties": {
    "source": { "type": "string", "format": "uri" },
    "lastVerifiedAt": { "type": "string", "format": "date" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "media", "status", "capabilities", "limits", "strengths", "avoidWhen", "defaultUse"]
      }
    }
  }
}
