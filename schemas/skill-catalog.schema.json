{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeShop client Skill catalog",
  "type": "object",
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "description", "category", "categoryTags", "coverImage", "routeLabel", "tone", "featured", "whatThisSkillDoes", "howToUse", "output"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "categoryTags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "coverImage": { "type": "string", "pattern": "^https://ai-image\\.weshop\\.com/desktop/coverImage/[a-z0-9-]+\\.(png|jpg|jpeg|webp|gif|avif|svg)$" },
        "coverMotion": { "type": "string", "pattern": "^https://ai-image\\.weshop\\.com/desktop/coverVideo/[a-z0-9-]+\\.(mp4|webm)$" },
        "sourceImages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://ai-image\\.weshop\\.com/desktop/sourceImage/[a-z0-9-]+(?:-[1-9][0-9]*)?\\.(png|jpg|jpeg|webp|gif|avif)$" } },
        "routeLabel": { "type": "string", "minLength": 1 },
        "tone": { "type": "string", "minLength": 1 },
        "featured": { "type": "boolean" },
        "whatThisSkillDoes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "howToUse": {
          "type": "object", "additionalProperties": false, "required": ["summary", "promptExamples"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "promptExamples": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["title", "prompt"], "properties": { "title": { "type": "string", "minLength": 1 }, "prompt": { "type": "string", "minLength": 1 } } } }
          }
        },
        "output": { "type": "object", "required": ["Media type"], "additionalProperties": { "type": "string" } },
        "similarSkills": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["id", "displayName", "difference"], "properties": { "id": { "type": "string" }, "displayName": { "type": "string" }, "difference": { "type": "string", "minLength": 1 } } } }
        ,"media": {
          "type": "object", "additionalProperties": false, "required": ["cn", "global"],
          "properties": {
            "cn": { "$ref": "#/$defs/marketMedia" },
            "global": { "$ref": "#/$defs/marketMedia" }
          }
        },
        "locales": {
          "type": "object", "additionalProperties": false,
          "patternProperties": {
            "^(zh-CN|en-US)$": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "displayName": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "category": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "availability": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "markets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["cn", "global"] } },
            "reasonCode": { "type": "string", "pattern": "^[a-z0-9._-]+$" }
          }
        }
      }
    },
    "marketMedia": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "cover": { "type": "string", "pattern": "^https://[^/]+/.+\\.(png|jpg|jpeg|webp|gif|avif|svg)$" },
        "coverMotion": { "type": "string", "pattern": "^https://[^/]+/.+\\.(mp4|webm)$" },
        "sourceImages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[^/]+/.+\\.(png|jpg|jpeg|webp|gif|avif)$" } }
      }
    }
  }
}
