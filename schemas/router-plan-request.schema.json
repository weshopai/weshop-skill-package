{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weshop.ai/schemas/router-plan-request.schema.json",
  "title": "WeShop Router request",
  "description": "Minimal semantic input for selecting one Skill, one workflow, or one routing clarification. Runtime concerns are intentionally excluded.",
  "type": "object",
  "required": [
    "intent"
  ],
  "properties": {
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "taskId": {
      "$ref": "#/$defs/openId"
    },
    "taskClassId": {
      "$ref": "#/$defs/openId"
    },
    "availableInputRoles": {
      "$ref": "#/$defs/roleSet"
    },
    "workflowId": {
      "$ref": "#/$defs/openId"
    },
    "directDecision": {
      "$ref": "#/$defs/directDecision"
    },
    "blockingAmbiguities": {
      "$ref": "#/$defs/stringSet"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "openId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roleSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "raw",
        "outcome",
        "assets",
        "constraints",
        "deliverables",
        "requiresResearch",
        "confidence",
        "ambiguities"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "$ref": "#/$defs/roleSet"
        },
        "constraints": {
          "$ref": "#/$defs/stringSet"
        },
        "deliverables": {
          "$ref": "#/$defs/stringSet"
        },
        "requiresResearch": {
          "type": "boolean"
        },
        "researchMode": {
          "enum": [
            "none",
            "atom-owned",
            "separate-step"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguities": {
          "$ref": "#/$defs/stringSet"
        }
      },
      "additionalProperties": false
    },
    "intentMatch": {
      "type": "object",
      "required": [
        "skillId",
        "intentMatchScore",
        "reason"
      ],
      "properties": {
        "skillId": {
          "$ref": "#/$defs/openId"
        },
        "intentMatchScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "directDecision": {
      "type": "object",
      "required": [
        "kind",
        "selectedSkillId",
        "candidates"
      ],
      "properties": {
        "kind": {
          "const": "direct-atom"
        },
        "selectedSkillId": {
          "$ref": "#/$defs/openId"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/intentMatch"
          }
        },
        "usedRuntimeFallback": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
