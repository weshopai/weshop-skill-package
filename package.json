{
  "name": "weshop-skill-package",
  "version": "0.5.0",
  "description": "Selection-only WeShop Router, Atom Skills, multi-step workflow orchestration, model catalog, and maintenance tooling.",
  "license": "MIT",
  "author": "WeShop AI",
  "homepage": "https://github.com/weshopai/weshop-skill-package#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weshopai/weshop-skill-package.git"
  },
  "bugs": {
    "url": "https://github.com/weshopai/weshop-skill-package/issues"
  },
  "keywords": [
    "weshop",
    "agent-skills",
    "codex",
    "claude-code",
    "cursor",
    "creative-ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "weshopDesktop": {
    "schemaVersion": 1,
    "runtimeResources": [
      "skills",
      "catalog/skills.json",
      "schemas/router-plan-request.schema.json",
      "schemas/router-plan.schema.json",
      "shared/model-selection.md",
      "LICENSE"
    ]
  },
  "bin": {
    "weshop-skills": "scripts/weshop-skills.mjs"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "skills/",
    "catalog/skills.json",
    "schemas/skill-catalog.schema.json",
    "schemas/router-plan-request.schema.json",
    "schemas/router-plan.schema.json",
    "models/catalog.json",
    "scripts/weshop-skills.mjs",
    "scripts/manage-skills.mjs",
    "scripts/upload-skill-media.mjs",
    "scripts/create-custom-skill-draft.mjs",
    "scripts/check-api-key.mjs",
    "shared/model-selection.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean --silent && tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js && npm run test:router-map && npm run test:auto-update && npm run test:custom-skills && npm run test:package-cli && npm run test:auth-contract && npm run test:skill-intake",
    "test:router-map": "node --test scripts/router-map.test.mjs",
    "test:auto-update": "node --test scripts/auto-update.test.mjs",
    "test:custom-skills": "node --test scripts/custom-skills.test.mjs",
    "test:skill-intake": "node --test scripts/skill-intake.test.mjs",
    "test:package-cli": "node --test scripts/package-cli.test.mjs",
    "test:auth-contract": "node --test scripts/auth-contract.test.mjs",
    "models:validate": "node scripts/validate-model-catalog.mjs",
    "models:routing-validate": "node scripts/validate-model-routing.mjs",
    "router:validate": "node scripts/validate-router-map.mjs",
    "media:upload": "node scripts/upload-skill-media.mjs",
    "api-key:check": "node scripts/check-api-key.mjs",
    "prepare": "npm run build",
    "skills:manage": "node scripts/manage-skills.mjs",
    "skills:auto-update": "node scripts/auto-update.mjs",
    "skills:intake": "node scripts/create-skill-intake.mjs",
    "skills:custom:init": "node scripts/create-custom-skill-draft.mjs",
    "skills:custom:check": "node skills/create-custom-skill/scripts/check-custom-skill.mjs",
    "package:check": "node scripts/validate-npm-package.mjs",
    "docs:validate": "node scripts/validate-readme.mjs",
    "maintainers:validate": "node scripts/validate-maintainer-docs.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "sharp": "^0.34.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0"
  }
}
